#include <Windows.h>
#include "resource.h"

IDI_APP_ICON ICON "app.ico"
IDI_TRAY_ICON ICON "app.ico"
IDR_APP_MANIFEST RT_MANIFEST "app.manifest"
IDR_SETTINGS_XAML RCDATA "settings.xaml"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,2,0,0
 PRODUCTVERSION 0,2,0,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "DropCode"
            VALUE "FileDescription", "DropCode"
             VALUE "FileVersion", "0.2.0.0"
            VALUE "InternalName", "DropCode"
            VALUE "OriginalFilename", "DropCode.exe"
            VALUE "ProductName", "DropCode"
             VALUE "ProductVersion", "0.2.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

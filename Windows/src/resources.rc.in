#include <Windows.h>
#include "@CMAKE_CURRENT_SOURCE_DIR@/src/resource.h"

IDI_APP_ICON ICON "@CMAKE_CURRENT_SOURCE_DIR@/src/app.ico"
IDI_TRAY_ICON ICON "@CMAKE_CURRENT_SOURCE_DIR@/src/app.ico"
IDR_APP_MANIFEST RT_MANIFEST "@CMAKE_CURRENT_BINARY_DIR@/generated/app.manifest"
IDR_SETTINGS_XAML RCDATA "@CMAKE_CURRENT_SOURCE_DIR@/src/settings.xaml"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @DROPCODE_VERSION_COMMAS@
 PRODUCTVERSION @DROPCODE_VERSION_COMMAS@
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "DropCode"
            VALUE "FileDescription", "DropCode"
            VALUE "FileVersion", "@DROPCODE_VERSION_FOUR@"
            VALUE "InternalName", "DropCode"
            VALUE "OriginalFilename", "DropCode.exe"
            VALUE "ProductName", "DropCode"
            VALUE "ProductVersion", "@DROPCODE_VERSION_FOUR@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
